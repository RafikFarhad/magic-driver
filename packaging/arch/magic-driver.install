post_install() {
  cat <<'EOF'
==> magic-driver is installed but not enabled. Nothing changes until you turn it on.
==> Turn it on for your user (inside your Plasma session, without sudo):
      systemctl --user enable --now magic-driver
==> Check it:
      magic-driver status
      magic-driver doctor
==> Optional config: copy /usr/share/doc/magic-driver/config.example.toml
    to ~/.config/magic-driver/config.toml
==> Turn it off again:
      systemctl --user disable --now magic-driver
EOF
}

post_upgrade() {
  cat <<'EOF'
==> magic-driver was upgraded. If the service is enabled, restart it:
      systemctl --user restart magic-driver
EOF
}

pre_remove() {
  cat <<'EOF'
==> Removing magic-driver. If the service is still enabled for your user, run first:
      systemctl --user disable --now magic-driver
EOF
}
